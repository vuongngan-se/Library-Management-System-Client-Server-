<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.chart.*?>

<BorderPane prefHeight="720.0" prefWidth="1100.0" styleClass="root" stylesheets="@/css/style.css" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.library.client.controller.MainController">
    <!-- Top Navigation Bar -->
    <top>
        <HBox alignment="CENTER_LEFT" styleClass="navbar" BorderPane.alignment="CENTER">
            <children>
                <Label styleClass="nav-title" text="📚 PHẦN MỀM QUẢN LÝ THƯ VIỆN CLIENT-SERVER" />
                <Region HBox.hgrow="ALWAYS" />
                <Label fx:id="lblUserInfo" text="Xin chào, User (Chức vụ)" textFill="WHITE">
                    <font>
                        <Font name="System Bold" size="14.0" />
                    </font>
                    <HBox.margin>
                        <Insets right="15.0" />
                    </HBox.margin>
                </Label>
                <Button fx:id="btnThemeToggle" onAction="#handleToggleTheme" style="-fx-background-color: rgba(255,255,255,0.15); -fx-text-fill: white; -fx-font-size: 13px; -fx-font-weight: bold; -fx-padding: 8 14; -fx-background-radius: 6; -fx-cursor: hand;" text="🌙 Giao diện Tối">
                    <HBox.margin>
                        <Insets right="10.0" />
                    </HBox.margin>
                </Button>
                <Button onAction="#handleLogout" styleClass="btn-danger" text="Đăng xuất" />
            </children>
        </HBox>
    </top>

    <!-- Left Sidebar -->
    <left>
        <VBox prefWidth="220.0" styleClass="sidebar" BorderPane.alignment="CENTER">
            <children>
                <Button fx:id="btnNavDashboard" maxWidth="1.7976931348623157E308" onAction="#showDashboard" styleClass="sidebar-btn, sidebar-btn-active" text="📊 Tổng quan &amp; Báo cáo" />
                <Button fx:id="btnNavBooks" maxWidth="1.7976931348623157E308" onAction="#showBooks" styleClass="sidebar-btn" text="📖 Quản lý Sách" />
                <Button fx:id="btnNavReaders" maxWidth="1.7976931348623157E308" onAction="#showReaders" styleClass="sidebar-btn" text="🎴 Quản lý Độc giả" />
                <Button fx:id="btnNavBorrow" maxWidth="1.7976931348623157E308" onAction="#showBorrow" styleClass="sidebar-btn" text="🔄 Mượn &amp; Trả sách" />
                <Button fx:id="btnNavReservations" maxWidth="1.7976931348623157E308" onAction="#showReservations" styleClass="sidebar-btn" text="📌 Đặt trước Sách" />
                <Button fx:id="btnNavFines" maxWidth="1.7976931348623157E308" onAction="#showFines" styleClass="sidebar-btn" text="💰 Quản lý Tiền phạt" />
                <Button fx:id="btnNavNetwork" maxWidth="1.7976931348623157E308" onAction="#showNetwork" styleClass="sidebar-btn" text="🌐 Giám sát Mạng" />
                <Button fx:id="btnNavUsers" maxWidth="1.7976931348623157E308" onAction="#showUsers" styleClass="sidebar-btn" text="👥 Quản lý Tài khoản" />
                <Button fx:id="btnNavChat" maxWidth="1.7976931348623157E308" onAction="#showChat" styleClass="sidebar-btn" text="💬 Trò chuyện Nội bộ" />
            </children>
        </VBox>
    </left>

    <!-- Main Content Area (Dynamic Views) -->
    <center>
        <StackPane fx:id="contentArea" style="-fx-padding: 20px;" BorderPane.alignment="CENTER">
            <!-- Dashboard View -->
            <VBox fx:id="viewDashboard" spacing="15.0">
                <children>
                    <Label text="Bảng điều khiển &amp; Thống kê" textFill="#2c3e50">
                        <font>
                            <Font name="System Bold" size="20.0" />
                        </font>
                    </Label>
                    <ScrollPane fitToWidth="true" styleClass="content-scrollpane" VBox.vgrow="ALWAYS">
                        <content>
                            <VBox spacing="20.0">
                                <children>
                                    <GridPane hgap="20.0" vgap="20.0">
                                        <columnConstraints>
                                            <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                                            <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                                            <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                                            <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                                        </columnConstraints>
                                        <rowConstraints>
                                            <RowConstraints minHeight="10.0" prefHeight="110.0" vgrow="SOMETIMES" />
                                        </rowConstraints>
                                        <children>
                                            <VBox styleClass="metric-card, metric-card-blue" GridPane.columnIndex="0">
                                                <children>
                                                    <Label styleClass="metric-title" text="TỔNG ĐẦU SÁCH" />
                                                    <Label fx:id="lblStatTotalBooks" styleClass="metric-value" text="0" />
                                                </children>
                                            </VBox>
                                            <VBox styleClass="metric-card, metric-card-green" GridPane.columnIndex="1">
                                                <children>
                                                    <Label styleClass="metric-title" text="SÁCH KHẢ DỤNG" />
                                                    <Label fx:id="lblStatAvailableBooks" styleClass="metric-value" text="0" />
                                                </children>
                                            </VBox>
                                            <VBox styleClass="metric-card, metric-card-purple" GridPane.columnIndex="2">
                                                <children>
                                                    <Label styleClass="metric-title" text="ĐỘC GIẢ ĐĂNG KÝ" />
                                                    <Label fx:id="lblStatTotalReaders" styleClass="metric-value" text="0" />
                                                </children>
                                            </VBox>
                                            <VBox styleClass="metric-card, metric-card-orange" GridPane.columnIndex="3">
                                                <children>
                                                    <Label styleClass="metric-title" text="PHIẾU ĐANG MƯỢN" />
                                                    <Label fx:id="lblStatActiveBorrowings" styleClass="metric-value" text="0" />
                                                </children>
                                            </VBox>
                                        </children>
                                    </GridPane>

                                    <!-- Charts Section -->
                                    <GridPane hgap="20.0" vgap="20.0">
                                        <columnConstraints>
                                            <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" percentWidth="45.0" />
                                            <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" percentWidth="55.0" />
                                        </columnConstraints>
                                        <children>
                                            <VBox prefHeight="330.0" styleClass="card" GridPane.columnIndex="0">
                                                <children>
                                                    <Label text="📊 Cơ cấu Sách theo Thể loại" textFill="#2c3e50">
                                                        <font>
                                                            <Font name="System Bold" size="14.0" />
                                                        </font>
                                                        <VBox.margin>
                                                            <Insets bottom="10.0" />
                                                        </VBox.margin>
                                                    </Label>
                                                    <PieChart fx:id="chartCategory" animated="false" legendSide="BOTTOM" VBox.vgrow="ALWAYS" />
                                                </children>
                                            </VBox>
                                            <VBox prefHeight="330.0" styleClass="card" GridPane.columnIndex="1">
                                                <children>
                                                    <Label text="📈 Top Sách được Mượn Nhiều Nhất" textFill="#2c3e50">
                                                        <font>
                                                            <Font name="System Bold" size="14.0" />
                                                        </font>
                                                        <VBox.margin>
                                                            <Insets bottom="10.0" />
                                                        </VBox.margin>
                                                    </Label>
                                                    <BarChart fx:id="chartTopBooks" animated="false" legendVisible="false" VBox.vgrow="ALWAYS">
                                                        <xAxis>
                                                            <CategoryAxis fx:id="axisBookTitle" label="Tên sách" side="BOTTOM" />
                                                        </xAxis>
                                                        <yAxis>
                                                            <NumberAxis fx:id="axisBorrowCount" label="Số lượt mượn" side="LEFT" />
                                                        </yAxis>
                                                    </BarChart>
                                                </children>
                                            </VBox>
                                        </children>
                                    </GridPane>

                                    <!-- Recent Activities Table -->
                                    <VBox prefHeight="260.0" styleClass="card">
                                        <children>
                                            <Label text="Hoạt động gần đây trong hệ thống" textFill="#2c3e50">
                                                <font>
                                                    <Font name="System Bold" size="15.0" />
                                                </font>
                                                <VBox.margin>
                                                    <Insets bottom="10.0" />
                                                </VBox.margin>
                                            </Label>
                                            <TableView fx:id="tblDashboardBorrowings" prefHeight="200.0" VBox.vgrow="ALWAYS">
                                                <columns>
                                                    <TableColumn fx:id="colDashId" prefWidth="70.0" text="Mã phiếu" />
                                                    <TableColumn fx:id="colDashReader" prefWidth="150.0" text="Mã độc giả" />
                                                    <TableColumn fx:id="colDashBorrowDate" prefWidth="120.0" text="Ngày mượn" />
                                                    <TableColumn fx:id="colDashDueDate" prefWidth="120.0" text="Hạn trả" />
                                                    <TableColumn fx:id="colDashStatus" prefWidth="120.0" text="Trạng thái" />
                                                </columns>
                                            </TableView>
                                        </children>
                                    </VBox>
                                </children>
                            </VBox>
                        </content>
                    </ScrollPane>
                </children>
            </VBox>

            <!-- Books View -->
            <VBox fx:id="viewBooks" spacing="15.0" visible="false">
                <children>
                    <HBox alignment="CENTER_LEFT" spacing="15.0">
                        <children>
                            <Label text="Quản lý thông tin Sách" textFill="#2c3e50">
                                <font>
                                    <Font name="System Bold" size="20.0" />
                                </font>
                            </Label>
                            <Region HBox.hgrow="ALWAYS" />
                            <TextField fx:id="txtSearchBook" prefWidth="250.0" promptText="Tìm kiếm sách theo tên, tác giả..." />
                            <Button onAction="#handleSearchBook" styleClass="btn-primary" text="Tìm kiếm" />
                            <Button onAction="#handleExportBooksCsv" styleClass="btn-secondary" text="📥 Xuất CSV" />
                        </children>
                    </HBox>
                    <HBox spacing="20.0" VBox.vgrow="ALWAYS">
                        <children>
                            <!-- Table View -->
                            <TableView fx:id="tblBooks" HBox.hgrow="ALWAYS">
                                <columns>
                                    <TableColumn fx:id="colBookId" prefWidth="60.0" text="Mã" />
                                    <TableColumn fx:id="colBookTitle" prefWidth="180.0" text="Tên sách" />
                                    <TableColumn fx:id="colBookAuthor" prefWidth="130.0" text="Tác giả" />
                                    <TableColumn fx:id="colBookCategory" prefWidth="110.0" text="Thể loại" />
                                    <TableColumn fx:id="colBookQuantity" prefWidth="70.0" text="Tổng số" />
                                    <TableColumn fx:id="colBookAvailable" prefWidth="70.0" text="Còn lại" />
                                </columns>
                            </TableView>
                            <!-- Form View -->
                            <VBox prefWidth="300.0" spacing="10.0" styleClass="card">
                                <children>
                                    <Label text="Thông tin Sách" textFill="#2c3e50">
                                        <font>
                                            <Font name="System Bold" size="14.0" />
                                        </font>
                                    </Label>
                                    <Label text="Tên sách:" />
                                    <TextField fx:id="txtBookTitle" />
                                    <Label text="Tác giả:" />
                                    <TextField fx:id="txtBookAuthor" />
                                    <Label text="Nhà xuất bản:" />
                                    <TextField fx:id="txtBookPublisher" />
                                    <Label text="Năm xuất bản:" />
                                    <TextField fx:id="txtBookYear" />
                                    <Label text="Số lượng nhập:" />
                                    <TextField fx:id="txtBookQuantity" />
                                    <Label text="Mã ISBN:" />
                                    <TextField fx:id="txtBookIsbn" />
                                    <Region VBox.vgrow="ALWAYS" />
                                    <HBox spacing="10.0">
                                        <children>
                                            <Button onAction="#handleAddBook" styleClass="btn-success" text="Thêm" HBox.hgrow="ALWAYS" />
                                            <Button onAction="#handleUpdateBook" styleClass="btn-primary" text="Sửa" HBox.hgrow="ALWAYS" />
                                            <Button onAction="#handleDeleteBook" styleClass="btn-danger" text="Xóa" HBox.hgrow="ALWAYS" />
                                        </children>
                                    </HBox>
                                    <Button maxWidth="Infinity" onAction="#handleShowBookQrCode" styleClass="btn-info" text="📱 Xem Mã QR Sách" />
                                    <Button maxWidth="Infinity" onAction="#handleQuickReserveBook" styleClass="btn-warning" text="📌 Đặt trước Sách này" />
                                </children>
                            </VBox>
                        </children>
                    </HBox>
                </children>
            </VBox>

            <!-- Readers View -->
            <VBox fx:id="viewReaders" spacing="15.0" visible="false">
                <children>
                    <HBox alignment="CENTER_LEFT" spacing="15.0">
                        <children>
                            <Label text="Quản lý Độc giả" textFill="#2c3e50">
                                <font>
                                    <Font name="System Bold" size="20.0" />
                                </font>
                            </Label>
                        </children>
                    </HBox>
                    <HBox spacing="20.0" VBox.vgrow="ALWAYS">
                        <children>
                            <TableView fx:id="tblReaders" HBox.hgrow="ALWAYS">
                                <columns>
                                    <TableColumn fx:id="colReaderId" prefWidth="60.0" text="Mã" />
                                    <TableColumn fx:id="colReaderName" prefWidth="180.0" text="Họ và tên" />
                                    <TableColumn fx:id="colReaderPhone" prefWidth="120.0" text="Số điện thoại" />
                                    <TableColumn fx:id="colReaderEmail" prefWidth="150.0" text="Email" />
                                    <TableColumn fx:id="colReaderStatus" prefWidth="100.0" text="Trạng thái thẻ" />
                                </columns>
                            </TableView>
                            <VBox prefWidth="300.0" spacing="10.0" styleClass="card">
                                <children>
                                    <Label text="Thông tin Độc giả" textFill="#2c3e50">
                                        <font>
                                            <Font name="System Bold" size="14.0" />
                                        </font>
                                    </Label>
                                    <Label text="Họ và tên:" />
                                    <TextField fx:id="txtReaderName" />
                                    <Label text="Số điện thoại:" />
                                    <TextField fx:id="txtReaderPhone" />
                                    <Label text="Email:" />
                                    <TextField fx:id="txtReaderEmail" />
                                    <Label text="Địa chỉ:" />
                                    <TextField fx:id="txtReaderAddress" />
                                    <Region VBox.vgrow="ALWAYS" />
                                    <HBox spacing="10.0">
                                        <children>
                                            <Button onAction="#handleAddReader" styleClass="btn-success" text="Thêm mới" HBox.hgrow="ALWAYS" />
                                            <Button onAction="#handleUpdateReader" styleClass="btn-primary" text="Cập nhật" HBox.hgrow="ALWAYS" />
                                        </children>
                                    </HBox>
                                    <Button maxWidth="Infinity" onAction="#handleShowReaderQrCard" styleClass="btn-info" text="🎴 Thẻ Độc Giả &amp; Mã QR" />
                                </children>
                            </VBox>
                        </children>
                    </HBox>
                </children>
            </VBox>

            <!-- Borrow View -->
            <VBox fx:id="viewBorrow" spacing="15.0" visible="false">
                <children>
                    <Label text="Quản lý Mượn &amp; Trả Sách" textFill="#2c3e50">
                        <font>
                            <Font name="System Bold" size="20.0" />
                        </font>
                    </Label>
                    <HBox spacing="20.0" VBox.vgrow="ALWAYS">
                        <!-- Borrow Creation Panel -->
                        <VBox prefWidth="400.0" spacing="10.0" styleClass="card">
                            <children>
                                <Label text="Lập phiếu mượn sách mới" textFill="#2c3e50">
                                    <font>
                                        <Font name="System Bold" size="15.0" />
                                    </font>
                                </Label>
                                <Label text="⚡ Quét mã QR / Nhập nhanh:" />
                                <TextField fx:id="txtQuickScan" onAction="#handleQuickScan" promptText="Quét/dán mã QR hoặc nhập ISBN/Mã thẻ rồi bấm Enter" style="-fx-border-color: #3b82f6; -fx-background-color: #f0f7ff;" />
                                <Label text="Mã độc giả:" />
                                <TextField fx:id="txtBorrowReaderId" promptText="Nhập ID độc giả" />
                                <Label text="Mã sách mượn (phân cách bằng dấu phẩy):" />
                                <TextField fx:id="txtBorrowBookIds" promptText="VD: 101,102" />
                                <Label text="Số ngày mượn:" />
                                <TextField fx:id="txtBorrowDays" text="14" />
                                <Button maxWidth="Infinity" onAction="#handleCreateBorrowing" styleClass="btn-success" text="Xác nhận mượn sách">
                                    <VBox.margin>
                                        <Insets top="15.0" />
                                    </VBox.margin>
                                </Button>
                            </children>
                        </VBox>

                        <!-- Borrowing History / Return Panel -->
                        <VBox HBox.hgrow="ALWAYS" spacing="10.0" styleClass="card">
                            <children>
                                <HBox alignment="CENTER_LEFT" spacing="10.0">
                                    <children>
                                        <Label text="Danh sách phiếu mượn" textFill="#2c3e50">
                                            <font>
                                                <Font name="System Bold" size="15.0" />
                                            </font>
                                        </Label>
                                        <Region HBox.hgrow="ALWAYS" />
                                        <Button onAction="#handleExportBorrowingsCsv" styleClass="btn-secondary" text="📥 Xuất CSV" />
                                        <Button onAction="#handleRenewSelectedBorrowing" styleClass="btn-info" text="Gia hạn (+7 ngày)" />
                                        <Button onAction="#handleReturnSelectedBorrowing" styleClass="btn-primary" text="Trả sách đã chọn" />
                                    </children>
                                </HBox>
                                <TableView fx:id="tblBorrowings" VBox.vgrow="ALWAYS">
                                    <columns>
                                        <TableColumn fx:id="colBorrowId" prefWidth="60.0" text="Mã" />
                                        <TableColumn fx:id="colBorrowReader" prefWidth="120.0" text="Mã độc giả" />
                                        <TableColumn fx:id="colBorrowDate" prefWidth="110.0" text="Ngày mượn" />
                                        <TableColumn fx:id="colBorrowDue" prefWidth="110.0" text="Hạn trả" />
                                        <TableColumn fx:id="colBorrowStatus" prefWidth="100.0" text="Trạng thái" />
                                        <TableColumn fx:id="colBorrowFine" prefWidth="100.0" text="Tiền phạt" />
                                    </columns>
                                </TableView>
                            </children>
                        </VBox>
                    </HBox>
                </children>
            </VBox>

            <!-- Fines View -->
            <VBox fx:id="viewFines" spacing="20.0" visible="false">
                <children>
                    <HBox alignment="CENTER_LEFT" spacing="15.0">
                        <children>
                            <Label text="Quản lý Tiền phạt &amp; Vi phạm" textFill="#2c3e50">
                                <font>
                                    <Font name="System Bold" size="20.0" />
                                </font>
                            </Label>
                            <Region HBox.hgrow="ALWAYS" />
                            <Button onAction="#handleExportFinesCsv" styleClass="btn-secondary" text="📥 Xuất CSV" />
                            <Button onAction="#handleRefreshFines" styleClass="btn-secondary" text="🔄 Làm mới" />
                            <Button onAction="#handlePaySelectedFine" styleClass="btn-success" text="💵 Thu tiền phạt" />
                        </children>
                    </HBox>
                    <TableView fx:id="tblFines" VBox.vgrow="ALWAYS">
                        <columns>
                            <TableColumn fx:id="colFineId" prefWidth="70.0" text="Mã phạt" />
                            <TableColumn fx:id="colFineBorrowId" prefWidth="90.0" text="Mã mượn" />
                            <TableColumn fx:id="colFineReader" prefWidth="170.0" text="Độc giả" />
                            <TableColumn fx:id="colFineAmount" prefWidth="120.0" text="Số tiền phạt" />
                            <TableColumn fx:id="colFineStatus" prefWidth="110.0" text="Trạng thái" />
                            <TableColumn fx:id="colFineReason" prefWidth="300.0" text="Lý do vi phạm" />
                            <TableColumn fx:id="colFineDate" prefWidth="150.0" text="Ngày tạo" />
                        </columns>
                    </TableView>
                </children>
            </VBox>

            <!-- Network Monitor View -->
            <VBox fx:id="viewNetwork" spacing="20.0" visible="false">
                <children>
                    <HBox alignment="CENTER_LEFT" spacing="15.0">
                        <children>
                            <Label text="🌐 Giám sát Kết nối Mạng TCP Socket thời gian thực" textFill="#2c3e50">
                                <font>
                                    <Font name="System Bold" size="20.0" />
                                </font>
                            </Label>
                            <Region HBox.hgrow="ALWAYS" />
                            <Button onAction="#handleRefreshSessions" styleClass="btn-secondary" text="🔄 Làm mới" />
                            <Button onAction="#handleKickSelectedSession" styleClass="btn-danger" text="⛔ Ngắt kết nối Client" />
                        </children>
                    </HBox>

                    <!-- Network Metric Summary Cards -->
                    <GridPane hgap="20.0" vgap="20.0">
                        <columnConstraints>
                            <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                            <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                            <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                        </columnConstraints>
                        <rowConstraints>
                            <RowConstraints minHeight="10.0" prefHeight="95.0" vgrow="SOMETIMES" />
                        </rowConstraints>
                        <children>
                            <VBox styleClass="metric-card, metric-card-blue" GridPane.columnIndex="0">
                                <children>
                                    <Label styleClass="metric-title" text="CLIENT ĐANG KẾT NỐI (ONLINE)" />
                                    <Label fx:id="lblStatActiveClients" styleClass="metric-value" text="0" />
                                </children>
                            </VBox>
                            <VBox styleClass="metric-card, metric-card-green" GridPane.columnIndex="1">
                                <children>
                                    <Label styleClass="metric-title" text="TỔNG REQUEST ĐÃ XỬ LÝ" />
                                    <Label fx:id="lblStatTotalRequests" styleClass="metric-value" text="0" />
                                </children>
                            </VBox>
                            <VBox styleClass="metric-card, metric-card-purple" GridPane.columnIndex="2">
                                <children>
                                    <Label styleClass="metric-title" text="CỔNG DỊCH VỤ SERVER" />
                                    <Label fx:id="lblStatServerPort" styleClass="metric-value" text="TCP: 8888" />
                                </children>
                            </VBox>
                        </children>
                    </GridPane>

                    <!-- Sessions Table -->
                    <VBox styleClass="card" VBox.vgrow="ALWAYS">
                        <children>
                            <Label text="Danh sách các phiên làm việc (Active TCP Sockets)" textFill="#2c3e50">
                                <font>
                                    <Font name="System Bold" size="14.0" />
                                </font>
                                <VBox.margin>
                                    <Insets bottom="10.0" />
                                </VBox.margin>
                            </Label>
                            <TableView fx:id="tblClientSessions" VBox.vgrow="ALWAYS">
                                <columns>
                                    <TableColumn fx:id="colSessionId" prefWidth="110.0" text="Mã phiên" />
                                    <TableColumn fx:id="colSessionIp" prefWidth="120.0" text="Địa chỉ IP" />
                                    <TableColumn fx:id="colSessionPort" prefWidth="80.0" text="Cổng Port" />
                                    <TableColumn fx:id="colSessionUser" prefWidth="130.0" text="Tài khoản" />
                                    <TableColumn fx:id="colSessionFullName" prefWidth="160.0" text="Họ và tên" />
                                    <TableColumn fx:id="colSessionRole" prefWidth="90.0" text="Vai trò" />
                                    <TableColumn fx:id="colSessionConnectedAt" prefWidth="150.0" text="Thời điểm kết nối" />
                                    <TableColumn fx:id="colSessionRequests" prefWidth="80.0" text="Số Request" />
                                    <TableColumn fx:id="colSessionLastAction" prefWidth="130.0" text="Lệnh gần nhất" />
                                </columns>
                            </TableView>
                        </children>
                    </VBox>
                </children>
            </VBox>

            <!-- Users View -->
            <VBox fx:id="viewUsers" spacing="15.0" visible="false">
                <children>
                    <HBox alignment="CENTER_LEFT" spacing="15.0">
                        <children>
                            <Label text="👥 Quản lý Tài khoản &amp; Phân quyền Nhân viên" textFill="#2c3e50">
                                <font>
                                    <Font name="System Bold" size="20.0" />
                                </font>
                            </Label>
                            <Region HBox.hgrow="ALWAYS" />
                            <TextField fx:id="txtSearchUser" prefWidth="250.0" promptText="Tìm theo username, họ tên..." />
                            <Button onAction="#handleSearchUser" styleClass="btn-primary" text="Tìm kiếm" />
                            <Button onAction="#handleRefreshUsers" styleClass="btn-secondary" text="🔄 Làm mới" />
                        </children>
                    </HBox>
                    <HBox spacing="20.0" VBox.vgrow="ALWAYS">
                        <children>
                            <!-- Table View -->
                            <TableView fx:id="tblUsers" HBox.hgrow="ALWAYS">
                                <columns>
                                    <TableColumn fx:id="colUserId" prefWidth="60.0" text="Mã NV" />
                                    <TableColumn fx:id="colUserUsername" prefWidth="140.0" text="Tên đăng nhập" />
                                    <TableColumn fx:id="colUserFullName" prefWidth="180.0" text="Họ và tên" />
                                    <TableColumn fx:id="colUserRole" prefWidth="100.0" text="Vai trò" />
                                    <TableColumn fx:id="colUserStatus" prefWidth="110.0" text="Trạng thái" />
                                </columns>
                            </TableView>

                            <!-- Form View -->
                            <VBox prefWidth="320.0" spacing="10.0" styleClass="card">
                                <children>
                                    <Label text="Thông tin Tài khoản" textFill="#2c3e50">
                                        <font>
                                            <Font name="System Bold" size="14.0" />
                                        </font>
                                    </Label>
                                    <Label text="Tên đăng nhập:" />
                                    <TextField fx:id="txtUserUsername" promptText="Ví dụ: thuthu_linh" />
                                    <Label text="Mật khẩu:" />
                                    <PasswordField fx:id="txtUserPassword" promptText="Mật khẩu (ít nhất 4 ký tự)" />
                                    <Label text="Họ và tên nhân viên:" />
                                    <TextField fx:id="txtUserFullName" promptText="Họ và tên đầy đủ" />
                                    <Label text="Vai trò phân quyền:" />
                                    <ComboBox fx:id="cbUserRole" maxWidth="Infinity" />
                                    <Label text="Trạng thái tài khoản:" />
                                    <ComboBox fx:id="cbUserStatus" maxWidth="Infinity" />
                                    <Region VBox.vgrow="ALWAYS" />
                                    <HBox spacing="8.0">
                                        <children>
                                            <Button onAction="#handleAddUser" styleClass="btn-success" text="Thêm" HBox.hgrow="ALWAYS" />
                                            <Button onAction="#handleUpdateUser" styleClass="btn-primary" text="Sửa" HBox.hgrow="ALWAYS" />
                                            <Button onAction="#handleResetUserPassword" styleClass="btn-info" text="Đổi MK" HBox.hgrow="ALWAYS" />
                                            <Button onAction="#handleDeleteUser" styleClass="btn-danger" text="Xóa" HBox.hgrow="ALWAYS" />
                                        </children>
                                    </HBox>
                                </children>
                            </VBox>
                        </children>
                    </HBox>
                </children>
            </VBox>

            <!-- Internal Live Chat View -->
            <VBox fx:id="viewChat" spacing="15.0" visible="false">
                <children>
                    <HBox alignment="CENTER_LEFT" spacing="10.0">
                        <children>
                            <Label text="💬 Kênh Trao đổi Nội bộ Thủ thư &amp; Quản trị" textFill="#2c3e50">
                                <font>
                                    <Font name="System Bold" size="20.0" />
                                </font>
                            </Label>
                            <Region HBox.hgrow="ALWAYS" />
                            <Label fx:id="lblChatStatus" style="-fx-background-color: #e8f8f5; -fx-text-fill: #1abc9c; -fx-padding: 4 10; -fx-background-radius: 12; -fx-font-weight: bold;" text="🟢 Đang kết nối trực tiếp" />
                            <Button fx:id="btnClearChat" onAction="#handleClearChat" styleClass="btn-danger" text="🗑 Xóa lịch sử" />
                        </children>
                    </HBox>

                    <!-- Main Chat Container -->
                    <VBox spacing="10.0" styleClass="card" VBox.vgrow="ALWAYS">
                        <children>
                            <ScrollPane fx:id="scrollChat" fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED" VBox.vgrow="ALWAYS" styleClass="content-scrollpane">
                                <content>
                                    <VBox fx:id="vboxChatMessages" spacing="12.0" style="-fx-padding: 10;" />
                                </content>
                            </ScrollPane>

                            <!-- Input Bar -->
                            <HBox alignment="CENTER" spacing="10.0" style="-fx-padding: 10 0 0 0; -fx-border-color: #edf2f7; -fx-border-width: 1 0 0 0;">
                                <children>
                                    <TextField fx:id="txtChatMessage" onAction="#handleSendChat" promptText="Nhập tin nhắn trao đổi với các thủ thư... (Nhấn Enter hoặc bấm nút Gửi)" HBox.hgrow="ALWAYS" style="-fx-font-size: 13px; -fx-pref-height: 40px;" />
                                    <Button fx:id="btnSendChat" onAction="#handleSendChat" styleClass="btn-primary" text="Gửi ✈" style="-fx-pref-height: 40px; -fx-font-weight: bold; -fx-pref-width: 90px;" />
                                </children>
                            </HBox>
                        </children>
                    </VBox>
                </children>
            </VBox>

            <!-- Reservations View -->
            <VBox fx:id="viewReservations" spacing="15.0" visible="false">
                <children>
                    <HBox alignment="CENTER_LEFT" spacing="10.0">
                        <children>
                            <Label text="📌 Quản lý Đặt trước Sách (Book Reservations)" textFill="#2c3e50">
                                <font>
                                    <Font name="System Bold" size="20.0" />
                                </font>
                            </Label>
                            <Region HBox.hgrow="ALWAYS" />
                            <Button onAction="#handleRefreshReservations" styleClass="btn-secondary" text="🔄 Làm mới" />
                            <Button onAction="#handleFulfillSelectedReservation" styleClass="btn-success" text="✅ Hoàn tất nhận sách" />
                            <Button onAction="#handleCancelSelectedReservation" styleClass="btn-danger" text="❌ Hủy đặt trước" />
                        </children>
                    </HBox>
                    <HBox spacing="20.0" VBox.vgrow="ALWAYS">
                        <!-- Table of reservations -->
                        <TableView fx:id="tblReservations" HBox.hgrow="ALWAYS">
                            <columns>
                                <TableColumn fx:id="colResId" prefWidth="60.0" text="Mã" />
                                <TableColumn fx:id="colResReader" prefWidth="160.0" text="Độc giả" />
                                <TableColumn fx:id="colResBook" prefWidth="200.0" text="Tên sách" />
                                <TableColumn fx:id="colResDate" prefWidth="110.0" text="Ngày đặt" />
                                <TableColumn fx:id="colResStatus" prefWidth="110.0" text="Trạng thái" />
                                <TableColumn fx:id="colResNotes" prefWidth="180.0" text="Ghi chú" />
                            </columns>
                        </TableView>
                        <!-- Form to create new reservation -->
                        <VBox prefWidth="320.0" spacing="10.0" styleClass="card">
                            <children>
                                <Label text="Lập phiếu Đặt trước mới" textFill="#2c3e50">
                                    <font>
                                        <Font name="System Bold" size="14.0" />
                                    </font>
                                </Label>
                                <Label text="Mã độc giả:" />
                                <TextField fx:id="txtResReaderId" promptText="Nhập ID độc giả (VD: 1)" />
                                <Label text="Mã sách đặt trước:" />
                                <TextField fx:id="txtResBookId" promptText="Nhập ID sách (VD: 101)" />
                                <Label text="Ghi chú / Yêu cầu:" />
                                <TextArea fx:id="txtResNotes" prefRowCount="3" promptText="Nhập lý do hẹn lấy hoặc thời gian mong muốn..." wrapText="true" />
                                <Region VBox.vgrow="ALWAYS" />
                                <Button maxWidth="Infinity" onAction="#handleCreateNewReservation" styleClass="btn-primary" text="📌 Xác nhận Đặt trước" />
                            </children>
                        </VBox>
                    </HBox>
                </children>
            </VBox>
        </StackPane>
    </center>
</BorderPane>
